<?xml version="1.0" encoding="utf-8"?>
<!-- A native ad as a strip across the top of the screen: icon, "Ad" badge, headline, body and the call to action.
     Colours are set from the JS style options. The AdChoices icon sits in the top right corner; the wider end padding
     keeps the button clear of it. A hairline along the bottom separates the ad from the screen below. -->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/admob_native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="7dp">

            <ImageView
                android:id="@+id/admob_native_ad_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/admob_native_ad_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:minWidth="18dp"
                        android:minHeight="16dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/admob_native_ad_badge"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/admob_native_ad_headline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/admob_native_ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/admob_native_ad_call_to_action"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:maxWidth="120dp"
                android:minWidth="64dp"
                android:minHeight="0dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingTop="0dp"
                android:paddingEnd="12dp"
                android:paddingBottom="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:id="@+id/admob_native_ad_divider"
            android:layout_width="match_parent"
            android:layout_height="1px" />
    </LinearLayout>

    <com.google.android.gms.ads.nativead.AdChoicesView
        android:id="@+id/admob_native_ad_choices"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end" />
</com.google.android.gms.ads.nativead.NativeAdView>
